# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edinet_analysis
POSTGRES_USER=edinet_user
POSTGRES_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@company-analyzer.com

# Service Ports
AUTH_SERVICE_PORT=3001
ANALYSIS_SERVICE_PORT=3002
DATA_INGESTION_PORT=3003
REPORT_GENERATOR_PORT=3004
API_GATEWAY_PORT=3000

# Service URLs (for internal communication)
AUTH_SERVICE_URL=http://auth-service:3001
ANALYSIS_SERVICE_URL=http://analysis-service:3002
DATA_INGESTION_URL=http://data-ingestion:3003
REPORT_GENERATOR_URL=http://report-generator:3004

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# Log Level
LOG_LEVEL=info