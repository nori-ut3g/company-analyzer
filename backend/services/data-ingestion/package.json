    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "file-type": "^19.0.0",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.6.3",
    "joi": "^17.12.1",
    "node-cron": "^3.0.3",
    "p-queue": "^8.0.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "retry": "^0.13.1",
    "sharp": "^0.33.2",
    "unzipper": "^0.10.14",
