# Application Environment
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://edinet_user:edinet_pass@localhost:5432/edinet_analysis
POSTGRES_USER=edinet_user
POSTGRES_PASSWORD=edinet_pass
POSTGRES_DB=edinet_analysis

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# External API Keys
EDINET_API_KEY=your-edinet-api-key
CLAUDE_API_KEY=your-claude-api-key

# Service URLs (for local development)
API_GATEWAY_URL=http://localhost:8000
DATA_INGESTION_URL=http://localhost:3001
ANALYSIS_SERVICE_URL=http://localhost:3002
REPORT_GENERATOR_URL=http://localhost:3003
AUTH_SERVICE_URL=http://localhost:3004

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Logging
LOG_LEVEL=debug