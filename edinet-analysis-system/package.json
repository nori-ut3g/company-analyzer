{
  "name": "edinet-analysis-system",
  "version": "1.0.0",
  "description": "EDINET Analysis System - Root package for managing all services",
  "private": true,
  "workspaces": [
    "frontend",
    "api-gateway",
    "services/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api-gateway\" \"npm run dev:services\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:api-gateway": "npm run dev --workspace=api-gateway",
    "dev:services": "concurrently \"npm run dev:data-ingestion\" \"npm run dev:analysis\" \"npm run dev:report\" \"npm run dev:auth\"",
    "dev:data-ingestion": "npm run dev --workspace=data-ingestion-service",
    "dev:analysis": "npm run dev --workspace=analysis-service",
    "dev:report": "npm run dev --workspace=report-generator-service",
    "dev:auth": "npm run dev --workspace=auth-service",
    "build": "npm run build:all",
    "build:all": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/node": "^20.11.17",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}