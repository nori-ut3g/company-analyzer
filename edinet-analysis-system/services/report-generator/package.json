{
  "name": "report-generator-service",
  "version": "1.0.0",
  "description": "EDINET Analysis System - Report Generator Service",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.1.1",
    "puppeteer": "^21.11.0",
    "handlebars": "^4.7.8",
    "pdfkit": "^0.14.0",
    "exceljs": "^4.4.0",
    "chart.js": "^4.4.1",
    "chartjs-node-canvas": "^4.1.6",
    "nodemailer": "^6.9.9",
    "html-pdf": "^3.0.1",
    "markdown-pdf": "^11.0.0",
    "winston": "^3.11.0",
    "dotenv": "^16.4.1",
    "joi": "^17.12.1",
    "bull": "^4.12.2",
    "aws-sdk": "^2.1552.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.2",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.17",
    "@types/pdfkit": "^0.13.3",
    "@types/nodemailer": "^6.4.14",
    "@types/multer": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.11",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "ts",
    "exec": "ts-node src/index.ts"
  }
}